DATABASE_URL="postgresql://postgres:postgres@localhost:5432/icgit2026?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/icgit2026?schema=public"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
RESEND_API_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PUBLIC_CONFERENCE_SLUG="icgit-2026"
STORAGE_PROVIDER="local"
LOCAL_STORAGE_PATH="./storage"

# Public form verification: set a random secret of at least 32 characters.
# If left empty, the existing ADMIN_SESSION_SECRET is used.
SUBMISSION_CHALLENGE_SECRET=""

# Exact browser origin, without /ICGIT or a trailing slash. Required for mutations.
PUBLIC_APP_ORIGIN="http://localhost:3000"
ADMIN_EMAIL=""
# Format: scrypt$<32 hex salt>$<128 hex derived key>. Never store a plaintext password.
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# Keep disabled until the reviewed migration and Sandbox checks are complete.
PAYPAL_ENABLED="false"
# Independent switches. Keep capture off until an operator approves Sandbox checkout.
PAYPAL_CAPTURE_ENABLED="false"
PAYPAL_WEBHOOK_ENABLED="true"
PAYPAL_RECONCILIATION_ENABLED="true"
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MERCHANT_ID=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_LIVE_APPROVED="false"
PAYMENT_EMAIL_FROM=""

EMAIL_PROVIDER="smtp"
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
